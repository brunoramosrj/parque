# =========================================================================
#
#  ARQUIVO DE CONFIGURACAO DO SISTEMA DE INVENTARIO (Parque 3.x)
#
#  Copie este arquivo para parque.conf e ajuste somente o que precisar.
#  O parque.conf real fica fora do Git para permitir configuracoes locais.
#
# =========================================================================

# -------------------------------------------------------------------------
# PASTA BASE DO PROJETO (raiz onde fica inventario_web.html)
# - Em branco => calculada automaticamente como a pasta dos proprios scripts.
# - Preencha para apontar para um compartilhamento de rede, por exemplo:
#     Windows: PROJECT_DIR=\\servidor\parque$
#     Linux:   PROJECT_DIR=/mnt/parque
# -------------------------------------------------------------------------
PROJECT_DIR=

# -------------------------------------------------------------------------
# ARQUIVO E PASTAS DE TRABALHO (relativos a PROJECT_DIR se nao forem
# absolutos). Deixe em branco para usar os defaults abaixo.
# -------------------------------------------------------------------------
HTML_FILE=inventario_web.html
HTML_TEMPLATE_FILE=inventario_web.template.html
INVENTORY_DIR=inventario
SCHEMA_FILE=inventario_schema.json
COMANDOS_DIR=comandos
EXECUTADOS_DIR=executados
RETORNO_DIR=retorno

# Scripts coletores (usados pelo agente para disparar a coleta).
COLETOR_WINDOWS=windows.ps1
COLETOR_LINUX=linux.sh
CONSOLIDADOR_WINDOWS=consolidar_inventario.ps1
CONSOLIDADOR_LINUX=consolidar_inventario.sh

# -------------------------------------------------------------------------
# ALLOWLIST DE CAMINHOS (acoes instalar/copiar/executar/desinstalar)
# - Lista de pastas separadas por ';'. Somente arquivos dentro delas sao
#   aceitos. Ex.: PERMITIR_CAMINHOS=C:\softwares;\\servidor\parque\softwares
# - Em branco => permite tudo (compatibilidade) e registra aviso no log.
# -------------------------------------------------------------------------
PERMITIR_CAMINHOS=

# -------------------------------------------------------------------------
# PARAMETROS DE EXECUCAO
# -------------------------------------------------------------------------
INTERVALO_AGENTE_SEG=60
# Timeout máximo (s) por comando instalar/desinstalar/executar.
# 'executar' aceita timeout_seg por comando para sobrescrever este valor.
TEMPO_MAX_COMANDO_SEG=600
TENTATIVAS_GRAVACAO=5
ESPERA_GRAVACAO_SEG=3

# Marcadores que delimitam o bloco de dados JSON dentro do HTML central.
# Devem ser identicos em windows.ps1 e linux.sh. Nao altere sem motivo.
MARCADOR_DADOS_INI=//<DATA_START>
MARCADOR_DADOS_FIM=//<DATA_END>
